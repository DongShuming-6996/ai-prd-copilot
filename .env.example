# 本地/服务端真实模型配置（支持任意 OpenAI 兼容接口）
# 复制本文件为 .env.local 后填写（.env.local 已被 git 忽略，不会提交）

# DeepSeek 示例：
AI_API_BASE=https://api.deepseek.com
AI_API_KEY=sk-在这里填你的Key
AI_MODEL=deepseek-chat

# 服务端每个 IP 每日生成次数限制（默认 5）
USAGE_LIMIT=5

# 可选：DNS 污染时指定公共 DNS（阿里/腾讯），逗号分隔
# AI_DNS_SERVERS=223.5.5.5,119.29.29.29

# 不填 Key 时自动使用 Demo 模式（无需任何配置即可体验）
